{
    "name": "Social Stream Ninja (YouTube & TikTok)",
    "description": "Thu thập và quản lý bình luận trực tiếp từ YouTube và TikTok cho livestream",
    "manifest_version": 3,
    "version": "3.50.18",
    "homepage_url": "http://socialstream.ninja/",
    "browser_specific_settings": {
        "gecko": {
            "id": "{c7714925-0286-4dea-abc0-bbeb11fb0bfb}",
            "strict_min_version": "109.0"
        }
    },
    "icons": {
        "128": "icons/icon-128.png"
    },
    "background": {
        "service_worker": "service_worker.js"
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
    },
    "permissions": [
        "webNavigation",
        "notifications",
        "storage",
        "debugger",
        "tabs",
        "scripting",
        "activeTab",
        "tabCapture",
        "identity"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "providers/youtube/liveChat.js",
                "providers/youtube/contextResolver.js",
                "shared/utils/scriptLoader.js",
                "shared/utils/documentation.js",
                "shared/utils/contentImage.js",
                "shared/utils/chatBadges.js",
                "shared/utils/chatBadges.css",
                "shared/utils/chatHtml.js",
                "libs/objects.js",
                "shared/utils/compactSourceLayout.js",
                "shared/compact-source-layout.css",
                "shared/overlay-control-transport.js",
                "shared/operator-connection.js",
                "shared/input.js",
                "shared/alerts/*",
                "audio/alerts/*",
                "audio/catalog/*",
                "audio-library.html",
                "media/audio/*",
                "shared/stickers/*",
                "shared/monetization/*",
                "shared/audience-room/*",
                "shared/giveaway/*",
                "media/stickers/*",
                "shared/utils/html.js",
                "shared/aiPrompt/overlayStore.js",
                "shared/aiPrompt/security.js",
                "shared/aiPrompt/starter.js",
                "shared/aiPrompt/validation.js",
                "shared/aiEventOverlay/*",
                "shared/vendor/socket.io.min.js",
                "shared/ai/browserModelCatalog.js",
                "shared/ai/localBrowserLLM.js",
                "shared/ai/censorPrefilter.js",
                "shared/ai/censorModels.js",
                "shared/ai/censor-worker.js",
                "shared/ai/english-translation-worker.js",
                "shared/ai/local-translation-worker.js",
                "thirdparty/bergamot/*",
                "thirdparty/pako.min.js",
                "thirdparty/fasttext/*",
                "shared/ai/ragSemanticCache.js",
                "shared/ai/ragSemanticSearch.js",
                "shared/ai/rag-semantic-worker.js",
                "thirdparty/models/all-MiniLM-L6-v2/*",
                "thirdparty/models/granite-guardian-hap-38m/*",
                "local-browser-model-worker.js",
                "cohost-local-qwen-worker.js",
                "shared/tts/*",
                "thirdparty/neural-tts/*",
                "thirdparty/piper/piper-o91UDS6e.js",
                "thirdparty/piper/piper_phonemize.wasm",
                "thirdparty/piper/piper_phonemize.data"
            ],
            "matches": [
                "<all_urls>"
            ]
        },
        {
            "resources": [
                "sources/inject/streamelements-ws.js"
            ],
            "matches": [
                "https://streamelements.com/*"
            ]
        }
    ],
    "host_permissions": [
        "http://127.0.0.1/*",
        "http://localhost/*",
        "http://localhost:8080/*",
        "http://localhost:8181/*",
        "http://localhost:11434/api/generate",
        "http://127.0.0.1:11434/api/generate",
        "https://socialstream.ninja/*",
        "https://*.socialstream.ninja/*",
        "https://io.socialstream.ninja/*",
        "https://*/*autoreloadwithsocialstream",
        "https://youtube.com/*",
        "https://www.youtube.com/*",
        "https://studio.youtube.com/*",
        "https://livecenter.tiktok.com/*",
        "https://www.tiktok.com/*live*",
        "https://tikfinity.zerody.one/*",
        "https://widgets.tikfinity.com/*",
        "https://*.tikfinity-browser-source.com/*"
    ],
    "content_scripts": [
        {
            "js": [
                "./sources/autoreload.js"
            ],
            "matches": [
                "https://*/*autoreloadwithsocialstream"
            ]
        },
        {
            "js": [
                "./sources/youtube.js"
            ],
            "matches": [
                "https://www.youtube.com/watch?v=*&socialstream",
                "https://youtube.com/live_chat*",
                "https://www.youtube.com/live_chat*"
            ]
        },
        {
            "js": [
                "./sources/youtube.js"
            ],
            "matches": [
                "https://studio.youtube.com/live_chat*"
            ],
            "all_frames": true
        },
        {
            "js": [
                "./sources/websocket/youtube.js"
            ],
            "matches": [
                "https://socialstream.ninja/sources/websocket/youtube*",
                "https://beta.socialstream.ninja/sources/websocket/youtube*",
                "https://socialstream.ninja/beta/sources/websocket/youtube*",
                "file:///C:/Users/steve/Code/social_stream/sources/websocket/youtube.html*",
                "http://localhost:8080/*/youtube.html*",
                "http://localhost:8181/*/youtube.html*"
            ]
        },
        {
            "js": [
                "./sources/static/youtube_static.js"
            ],
            "matches": [
                "https://www.youtube.com/*"
            ]
        },
        {
            "js": [
                "./sources/inject/tiktok-gift.js"
            ],
            "matches": [
                "https://www.tiktok.com/*live*",
                "https://livecenter.tiktok.com/*"
            ],
            "world": "MAIN",
            "run_at": "document_start"
        },
        {
            "js": [
                "./sources/tiktok.js"
            ],
            "matches": [
                "https://www.tiktok.com/*live*",
                "https://livecenter.tiktok.com/*",
                "http://localhost:8080/*/fav.html",
                "http://localhost:8181/*/fav.html"
            ]
        },
        {
            "js": [
                "./sources/tikfinity.js"
            ],
            "matches": [
                "https://tikfinity.zerody.one/widget/activity-feed*",
                "https://tikfinity.zerody.one/widget/vite/src/activity-feed/*",
                "https://widgets.tikfinity.com/*",
                "https://44d4d505-b6f1-46fe-94e3-8b61a456f875.tikfinity-browser-source.com/*"
            ],
            "all_frames": true
        }
    ],
    "options_ui": {
        "page": "settings/options.html"
    },
    "action": {
        "default_popup": "popup.html"
    }
}